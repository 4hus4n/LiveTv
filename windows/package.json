{
  "name": "live-tv",
  "productName": "Live TV",
  "version": "1.0.0",
  "description": "Watch an M3U / IPTV playlist on Windows",
  "author": "Ahusan",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "dashjs": "4.7.4",
    "hls.js": "1.5.17",
    "mpegts.js": "1.7.3"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.ahusan.livetv.desktop",
    "productName": "Live TV",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Live TV",
      "artifactName": "LiveTV-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "LiveTV-Portable-${version}.exe"
    }
  }
}
